ô[{"id": "8adb77b9-6c1c-4b25-9eae-75bbc4e99548", "description": "Call list_commits and report every commit it returns (sha, author, message).", "expected_output": "The full list of commits since the last release.", "async_execution?": false, "human_input?": false, "agent_role": "Commit Collector", "agent_key": "07b3002c25673f6c1e31cb365134e11b", "context": null, "tools_names": ["list_commits"]}, {"id": "bcfe154d-b86c-474f-9636-fcb12ae3dc9b", "description": "Draft Markdown release notes for version 2.4.0 from the collected commits.", "expected_output": "A Markdown release-notes draft covering every commit.", "async_execution?": false, "human_input?": false, "agent_role": "Release Notes Writer", "agent_key": "54f400d78124446effdd1b7cea7cc914", "context": ["Call list_commits and report every commit it returns (sha, author, message)."], "tools_names": []}, {"id": "b0c8ac74-f218-4e76-a05a-d9d0dbb6ad4a", "description": "Review the draft release notes. Run lint_markdown on the draft. Send the draft back to the Release Notes Writer exactly once, through the delegation tool, with the lint problems and any missing commits to fix. Then run lint_markdown on the revised notes and approve them.", "expected_output": "The word APPROVED on the first line, followed by the final release notes.", "async_execution?": false, "human_input?": false, "agent_role": "Release Notes Reviewer", "agent_key": "a6b4729efd156f2083161d5ca2c6c84c", "context": ["Draft Markdown release notes for version 2.4.0 from the collected commits."], "tools_names": ["lint_markdown"]}]JÄ÷
