n version is now 3.10. Users are encouraged to upgrade their environments accordingly.  \n  *(Contributed by sam, a7c9e1f)*\n\n---\n\nThank you to all contributors for making this release possible!","refusal":null,"role":"assistant","annotations":null,"audio":null,"function_call":null,"tool_calls":[],"reasoning":null},"stop_reason":null,"token_ids":null,"routed_experts":null}],"created":1791937208,"model":"Qwen/Qwen3-235B-A22B-Instruct-2507","object":"chat.completion","moderation":null,"service_tier":null,"system_fingerprint":"vllm-v0.22.0-tp4-8006095a","usage":{"completion_tokens":488,"prompt_tokens":372,"total_tokens":860,"completion_tokens_details":null,"prompt_tokens_details":null},"prompt_logprobs":null,"prompt_token_ids":null,"prompt_text":null,"kv_transfer_params":null}J&
